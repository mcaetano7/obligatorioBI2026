  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>conexion_mysql_libros</connection>
    <sql>SELECT 
    url_goodreads,
    subgenero_archivo AS nombre_subgenero,
    MAX(titulo_libro) AS titulo_libro,
    MAX(COALESCE(NULLIF(TRIM(titulo_original), ''), titulo_libro)) AS titulo_original,
    MAX(COALESCE(NULLIF(TRIM(nombre_autor), ''), 'Autor Desconocido')) AS nombre_autor,
    MAX(
        CASE 
            WHEN idioma_edicion IS NULL 
              OR TRIM(idioma_edicion) = '' 
              OR LOWER(TRIM(idioma_edicion)) IN ('none', 'null', 'nan') 
            THEN 'Desconocido'
            ELSE TRIM(idioma_edicion)
        END
    ) AS idioma_edicion,
    MAX(
        CASE 
            WHEN descripcion_libro IS NULL 
              OR TRIM(descripcion_libro) = '' 
              OR LOWER(TRIM(descripcion_libro)) IN ('none', 'null', 'nan') 
            THEN 'Sin descripción'
            ELSE TRIM(descripcion_libro)
        END
    ) AS descripcion_libro,
    MAX(anio_publicacion) AS anio_publicacion,
    CASE 
        WHEN MAX(anio_publicacion) &lt;= 0 THEN 'Década Desconocida'
        ELSE CONCAT(FLOOR(MAX(anio_publicacion) / 10) * 10, 's')
    END AS decada,
    CASE 
        WHEN MAX(anio_publicacion) &lt;= 0 THEN 'Siglo Desconocido'
        ELSE CONCAT('Siglo ', FLOOR((MAX(anio_publicacion) - 1) / 100) + 1)
    END AS siglo,
    MAX(calificacion_promedio) AS calificacion_promedio,
    MAX(cantidad_votos) AS cantidad_votos,
    MAX(cantidad_resenas) AS cantidad_resenas
FROM fuente_libros_crudos
GROUP BY url_goodreads, subgenero_archivo;</sql>
    <limit>0</limit>
